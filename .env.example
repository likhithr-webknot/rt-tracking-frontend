# ──────────────────────────────────────────────
# RT Tracking Frontend — Environment Variables
# ──────────────────────────────────────────────
# Copy to `.env` or `.env.local` in this folder (same level as package.json).
# Restart `npm run dev` after changes. Only `VITE_*` keys are exposed in the browser.

# ── Backend (Spring / Webtrak) ─────────────────
# Start your API first. The Vite dev server proxies browser requests to it.
# Default proxy target is http://localhost:8080 (see vite.config.ts).
VITE_API_DEV_PROXY=http://localhost:8080

# Optional: force absolute API URLs (skips the dev proxy). Leave empty in local dev.
# Production: set to your deployed API origin, no trailing slash, e.g. https://api.example.com
VITE_API_BASE_URL=

# ── Auth / admin helpers (see src/api/auth.ts) ──
VITE_PERSIST_ACCESS_TOKEN=false
VITE_RAW_AUTHORIZATION_TOKEN=
VITE_ADMIN_EMAILS=

# Password flows use src/api/password-auth.ts — wire these on the server, e.g.:
#   POST /api/v1/auth/login
#   POST /api/v1/auth/forgot-password
#   POST /api/v1/auth/reset-password
