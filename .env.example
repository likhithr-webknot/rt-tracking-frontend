# ──────────────────────────────────────────────
# RT Tracking Frontend — Environment Variables
# ──────────────────────────────────────────────
# Copy to `.env` or `.env.local` in this folder (same level as package.json).
# Restart `npm run dev` after changes. Only `VITE_*` keys are exposed in the browser.

# ── Backend (Spring / Webtrak) ─────────────────
# Start your API first. The Vite dev server proxies browser requests to it.
# Default proxy target is http://localhost:8080 (see vite.config.ts).
VITE_API_DEV_PROXY=http://localhost:8080

# Optional: force absolute API URLs (skips the dev proxy). Leave empty in local dev.
# Production: set to your deployed API origin, no trailing slash, e.g. https://api.example.com
VITE_API_BASE_URL=

# Local backend over http://localhost — if login cookies are not kept, set on the API server:
# JWT_COOKIE_SECURE=false

# ── Webtrak third-party Team List (GET /api/v1/user/onboard) ──
# Prefer WEBTRAK_API_KEY — Vite injects it on /__webtrak (not sent to the browser).
# WEBTRAK_API_KEY=
# VITE_WEBTRAK_API_BASE=https://webtrak.webknot-dev.in
# Fallback for production builds (Authorization header):
# VITE_WEBTRAK_API_KEY=

# ── Supabase (Team List cache + shared platform DB) ──
# Prefer VITE_* (this app is Vite). NEXT_PUBLIC_* aliases are also read.
# VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Auth / admin helpers (see src/api/auth.ts) ──
VITE_PERSIST_ACCESS_TOKEN=false
VITE_RAW_AUTHORIZATION_TOKEN=
# Comma-separated Super Admin emails for portal routing (local only — do not use in seed scripts).
VITE_ADMIN_EMAILS=
# Comma-separated HR portal emails. Takes precedence over VITE_ADMIN_EMAILS.
VITE_HR_EMAILS=likhith.r@webknot.in

# ── QA seed scripts (npm run seed:minimal) ──
# Super Admin login required — pass via env only, never commit real credentials.
# SEED_API_BASE_URL=http://localhost:8080
# SEED_ADMIN_EMAIL=your-super-admin@webknot.in
# SEED_ADMIN_PASSWORD=
# VITE_ENABLE_DEV_QA=true
# Password flows use src/api/password-auth.ts — wire these on the server, e.g.:
#   POST /api/v1/auth/login
#   POST /api/v1/auth/forgot-password
#   POST /api/v1/auth/reset-password
