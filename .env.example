# ──────────────────────────────────────────────
# RT Tracking Frontend — Environment Variables
# ──────────────────────────────────────────────
# Copy this file to .env (or .env.local) and fill in values.
# Variables prefixed with VITE_ are exposed to the browser.

# Backend API base URL.
# In development this is handled by the Vite dev-server proxy,
# so you can leave it empty. For production builds set the full
# URL of the Spring Boot backend (no trailing slash).
VITE_API_BASE_URL=

# Backend target used by the Vite dev-server proxy. The default in
# vite.config.js is http://localhost:8080. Set this when your backend
# is running on another local port.
VITE_API_DEV_PROXY=http://localhost:8080

# Set to "true" to persist the access token across page reloads
# during development. In production this should be "false" (default).
VITE_PERSIST_ACCESS_TOKEN=false

# If set, frontend will send this raw value as the Authorization header.
# Example: moo$aidTheC0W -> Authorization: moo$aidTheC0W
# Useful when your backend expects a non-Bearer token scheme.
VITE_RAW_AUTHORIZATION_TOKEN=
